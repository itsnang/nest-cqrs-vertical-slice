ENV=local
PORT=3000

# used by docker-compose to provision the postgres container
PG_HOST=localhost
PG_PORT=5432
PG_USER=admin
PG_PASSWORD=admin
PG_DBNAME=nest_cqrs

# used by the app (config/configuration.ts) to connect — keep in sync with PG_* above
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=nest_cqrs
